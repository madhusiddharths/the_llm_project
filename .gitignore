# --- virtual environments --------------------------------------------------
.venv/
venv/
env/
.python-version

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- test / lint / type caches ---------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- secrets: teacher API keys, HF token, W&B key --------------------------
# Zero-spend build runs on free tiers; leaked keys burn the quota.
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
.netrc
.huggingface/
.wandb-api-key

# --- harvested data ---------------------------------------------------------
# Plan §8: trajectories are gitignored, the hashed manifest is committed.
# (exclude the *contents*, not the directory itself — git will not descend into
#  an excluded directory, which would make the manifest negation below dead)
data/trajectories/*
!data/trajectories/manifest*.json
!data/trajectories/.gitkeep
data/cache/
data/raw/
data/**/*.jsonl
!data/catalogs/**
!tests/fixtures/**

# --- model weights and adapters --------------------------------------------
# Checkpoints live on the HF Hub (plan §7), never in git.
checkpoints/
adapters/
outputs/
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# --- experiment tracking / tracing ------------------------------------------
wandb/
.wandb/
phoenix/
.phoenix/
*.db
*.sqlite
*.sqlite3
traces/

# NOTE: results/ is deliberately NOT ignored. Raw run JSON is the source of
# truth for the README table and the plots regenerate from it.
# Smoke and scaffold output is the exception — it is throwaway, and must never
# sit next to real numbers in git.
results/*.smoke.jsonl

# --- notebooks --------------------------------------------------------------
.ipynb_checkpoints/
notebooks/*-scratch.ipynb

# --- figures regenerated from results/ --------------------------------------
figures/*.png
figures/*.pdf

# --- docker / local services -------------------------------------------------
.docker/
docker-compose.override.yml

# --- editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- planning docs: local only, not published --------------------------------
division-of-labor.md
tool-router-ladder-plan.md

# --- agent tooling ----------------------------------------------------------
.claude/settings.local.json
graphify-out/
