# Copy to .env and fill in. .env is gitignored; .env.example is not.
# Zero-spend build — every key below is a free tier.

# ---------------------------------------------------------------------------
# TEACHER API — you need exactly ONE of these three working.
#
# This is a distillation project: a large model generates the training data
# that the small Qwen students learn to imitate. The teacher does three jobs:
#   1. Harvest (week 1)  — 55 tasks x 3 temperature samples -> the (state,
#                          action) pairs that ARE the training set. Bulk volume.
#   2. Baseline (week 1) — 60 eval tasks x 5 seeds -> the top row of every
#                          results table. Without it there is nothing to
#                          compare the students against.
#   3. Escalation (wk 4) — low-confidence steps route here. Low volume.
#
# A second provider is a fallback, not a requirement: the ranked risk list has
# "teacher API daily cap hit mid-harvest", and a spare key turns a lost day into
# a lost hour. Set TEACHER_PROVIDER to whichever you actually use.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# NVIDIA build.nvidia.com. LiteLLM requires exactly this name.
NVIDIA_NIM_API_KEY=

TEACHER_PROVIDER=groq

# ---------------------------------------------------------------------------
# HUGGING FACE — needs WRITE scope.
#
# The hard reason: Kaggle sessions are killed at 12 hours and take the local
# filesystem with them. LoRA adapters are pushed to the Hub after every epoch,
# so a session death costs one epoch instead of the whole run. This is what
# makes the training loop resumable.
#
# Minor reasons: Qwen2.5 base weights and most function-calling datasets are
# public and need no token, but anonymous downloads are rate-limited, and
# Kaggle re-downloads them every session.
#
# On Kaggle, set this as a Kaggle Secret — never paste it into a notebook cell.
# ---------------------------------------------------------------------------
HF_TOKEN=
HF_USERNAME=

# --- tracking ---------------------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=tool-router-ladder

# --- tracing: self-hosted Phoenix. Not LangSmith (free trace cap) -----------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
